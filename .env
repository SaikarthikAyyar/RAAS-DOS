# Welcome email - the backend calls a relay endpoint on Vercel
# (frontend/api/send-email.js) over HTTPS instead of sending SMTP
# directly, since Render's outbound network blocks raw SMTP ports
# (confirmed via [Errno 101] Network is unreachable). The relay itself
# holds the actual Gmail SMTP credentials as its own Vercel env vars
# (SMTP_USERNAME/SMTP_PASSWORD/SMTP_FROM_NAME) - not needed here.
EMAIL_RELAY_URL=https://raas-dos.vercel.app/api/send-email
EMAIL_RELAY_SECRET=aj7u_G1m0haocuYOFFs5Sch-pUFvUPsVamydlOmOmKE
