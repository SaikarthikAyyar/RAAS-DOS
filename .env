# Welcome email - the backend calls a relay endpoint on Vercel
# (frontend/api/send-email.js) over HTTPS instead of sending SMTP
# directly, since Render's outbound network blocks raw SMTP ports
# (confirmed via [Errno 101] Network is unreachable). The relay itself
# holds the actual Gmail SMTP credentials as its own Vercel env vars
# (SMTP_USERNAME/SMTP_PASSWORD/SMTP_FROM_NAME) - not needed here.
EMAIL_RELAY_URL=https://raas-dos.vercel.app/api/send-email
EMAIL_RELAY_SECRET=aj7u_G1m0haocuYOFFs5Sch-pUFvUPsVamydlOmOmKE

# File storage (Phase 41) - every upload now goes to Supabase Storage
# instead of local disk, since Render wipes local disk on every
# redeploy. SUPABASE_URL's project ref matches the Supabase DATABASE_URL
# above - confirm it's correct once filled in. SUPABASE_SERVICE_ROLE_KEY
# is a real secret (Supabase dashboard -> Settings -> API -> service_role) -
# fill it in here yourself, same as SMTP_PASSWORD above; it should never
# appear in chat. SUPABASE_STORAGE_BUCKET must be created in the Supabase
# dashboard first (Storage -> New bucket) - private is fine, no policy
# changes needed since only this backend ever calls Supabase directly.
